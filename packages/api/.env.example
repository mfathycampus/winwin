NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://winwin:winwin_secret@localhost:5432/winwin_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_SECRET_FOR_REFRESH_TOKENS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# SMS (mock in dev, unifonic or twilio in prod)
SMS_PROVIDER=mock

# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=winwin-media
# AWS_REGION=me-south-1

# Firebase (optional, for push notifications)
# FIREBASE_SERVICE_ACCOUNT=<base64 encoded service account JSON>

# Moyasar (Saudi payments)
# MOYASAR_SECRET_KEY=
# MOYASAR_PUBLISHABLE_KEY=

# Social OAuth (optional for Phase 2)
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
